{
    "branches": [
        "main"
    ],
    "plugins": [
        "@semantic-release/commit-analyzer",
        {
            "releaseRules": [
                {
                    "type": "feat",
                    "release": "minor"
                },
                {
                    "type": "fix",
                    "release": "patch"
                },
                {
                    "type": "refactor",
                    "release": "patch"
                },
                {
                    "type": "ci",
                    "release": "patch"
                },
                {
                    "type": "docs",
                    "release": false
                }
            ]
        }
    ]
}